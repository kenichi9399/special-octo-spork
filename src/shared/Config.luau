--!strict
--------------------------------------------------------------------------------
--  Config  |  ModuleScript
--  ReplicatedStorage > Tomori > Config
--
--  「灯-Tomori-」クリスタルシステムの全設定を管理する中央モジュール。
--  数値の変更はすべてここだけで完結する設計にする。
--
--  距離の単位: スタッド（1 stud ≈ 28cm in Roblox scale）
--  時間の単位: 秒
--------------------------------------------------------------------------------

local Config = {}

-- ===========================================================================
-- ■ CollectionService
-- ===========================================================================
Config.CRYSTAL_TAG = "GlowCrystal"

-- ===========================================================================
-- ■ 近接距離の設定
-- ===========================================================================
Config.OUTER_RADIUS = 22   -- この距離から influence が上昇し始める
Config.INNER_RADIUS = 5    -- この距離で influence が 1.0 に到達する

-- ===========================================================================
-- ■ 影響度の追従速度
-- ===========================================================================
-- influence は目標値へ指数関数的に収束する。
--   speed = 1.0 → 約 0.37 秒で目標値の 63% に到達 (1 - 1/e)
--   speed = 2.0 → 約 0.18 秒で同上 (2倍の速さ)
--   speed = 1.8 → 接近時:「ゆっくり目覚める」に丁度よい値
Config.INFLUENCE_SPEED = 1.8

-- ===========================================================================
-- ■ 遠方状態（influence = 0.0）
-- ===========================================================================
Config.FAR = {
    -- 黒曜石的な深い黒紫。素材が Neon でも Ambient にほぼ溶け込む暗さ
    Color           = Color3.fromRGB(40,  9,  72),
    LightBrightness = 0.03,
    LightRange      = 8,
    LightColor      = Color3.fromRGB(144,  72, 255),
}

-- ===========================================================================
-- ■ 近接状態（influence = 1.0）
-- ===========================================================================
Config.NEAR = {
    -- アメジストの中心から滲み出るような、淡く輝く紫白
    Color           = Color3.fromRGB(222, 155, 255),
    LightBrightness = 3.6,
    LightRange      = 28,
    LightColor      = Color3.fromRGB(240, 200, 255),
}

-- ===========================================================================
-- ■ 覚醒パルス（結晶が闇から光に目覚める一回性の輝き）
-- ===========================================================================
-- プレイヤーが近づき influence が AWAKE_THRESHOLD を超えた瞬間に発火する。
-- 減衰正弦波 e^(-decay × t) × sin(freq × 2π × t) で実装する。
Config.AWAKE_THRESHOLD = 0.04   -- この値を超えた瞬間を「目覚め」と定義
Config.AWAKE_FREQ      = 1.4    -- パルスの周波数 [Hz]
Config.AWAKE_DECAY     = 1.8    -- 包絡線の減衰速度（大きいほど短く消える）
Config.AWAKE_AMP_B     = 1.4    -- パルス最大輝度（FAR.LightBrightness に加算）

-- ===========================================================================
-- ■ 有機的呼吸アルゴリズムのパラメータ
-- ===========================================================================
-- 3 層の波形を合成して「生命感」を表現する。
--
--   Layer 1: 主呼吸 sine 波 — 安静時呼吸に近いゆっくりとした鼓動
--   Layer 2: Micro-tremor  — 黄金比周波数倍による非周期的な揺らぎ
--   Layer 3: Perlin noise  — 2 オクターブ重畳による有機的不規則性
--
-- [黄金比 φ ≈ 1.618 を使う理由]
--   整数倍でない周波数比は合成波を非周期にする。
--   黄金比は最も「整数に近い有理数近似を持たない」無理数であり、
--   機械的な繰り返し感が最も出にくい比として音楽理論でも使われる。
Config.BREATH = {

    -- [Layer 1] 主呼吸
    --   0.22 Hz ≈ 周期 4.5 秒 ≈ 成人の安静時呼吸数（12〜20 回/分）の下限
    FREQ_BASE    = 0.22,
    AMP_BRIGHT   = 0.65,   -- Brightness の半振幅
    AMP_COLOR    = 0.08,   -- Color.Value の半振幅

    -- [Layer 2] Micro-tremor
    --   FREQ_BASE × φ² ≈ 0.22 × 2.618 ≈ 0.576 Hz
    --   Layer 1 との周波数比が φ² （黄金比の2乗）で無理数になる
    FREQ_TREMOR  = 0.22 * 1.618 * 1.618,
    AMP_TREMOR   = 0.09,

    -- [Layer 3] Perlin noise 2オクターブ
    --   math.noise の戻り値: 概ね [-0.5, 0.5]
    --   第2オクターブを φ 倍の周波数で重ねてスペクトルを豊かにする
    FREQ_NOISE_1 = 0.13,
    FREQ_NOISE_2 = 0.13 * 1.618,
    AMP_NOISE    = 0.22,

    -- 合成波から各プロパティへの変換係数
    BRIGHT_SCALE = 0.42,   -- 合成波が Brightness に与える最大変化量
    RANGE_SCALE  = 3.0,    -- 合成波が Range に与える最大変化量 [スタッド]
}

-- ===========================================================================
-- ■ サーバー同期（他プレイヤーの接近を互いに見えるようにする）
-- ===========================================================================
Config.REMOTE_FOLDER_NAME     = "TomoriRemotes"
Config.REMOTE_ACTIVATED       = "CrystalActivated"
Config.REMOTE_DEACTIVATED     = "CrystalDeactivated"

-- 他プレイヤーが近くにいるとき、自分から見た結晶に加算する発光強度係数
-- 0 = 完全に無効, 1 = 自分が近くにいるときと同じ輝度
Config.REMOTE_INFLUENCE_FACTOR = 0.30

-- サーバーへ状態を通知する最小間隔（秒）。毎フレーム送信を防ぐ
Config.REMOTE_FIRE_COOLDOWN    = 0.5

-- ===========================================================================

-- テーブルをフリーズして実行時の誤った変更を防ぐ
Config.FAR    = table.freeze(Config.FAR)
Config.NEAR   = table.freeze(Config.NEAR)
Config.BREATH = table.freeze(Config.BREATH)

return table.freeze(Config)
